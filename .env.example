# Replace these values with your actual credentials
# DO NOT COMMIT YOUR ACTUAL .env FILE TO GITHUB

# 1. Your RPC URL from Alchemy or Infura (e.g., https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your-api-key"

# 2. Your MetaMask Private Key (export from MetaMask -> Account Details -> Show Private Key)
# Make sure it is JUST the key, no quotes needed unless there are special characters.
PRIVATE_KEY="your-wallet-private-key-here"
